# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.br7exsh.mongodb.net/eventflow?retryWrites=true&w=majority

# JWT Authentication Secret (32+ chars)
JWT_SECRET=your_super_secret_jwt_key_eventflow_2026

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Razorpay Test Credentials (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gmail SMTP Configuration for Booking Confirmations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM=Gather <noreply@gather.dev>

# Waitlist Configuration (Optional overrides)
# WAITLIST_MAX_CAPACITY=10
# WAITLIST_OFFER_DURATION_HOURS=2

# Environment
NODE_ENV=development
